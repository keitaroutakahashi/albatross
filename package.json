{
  "name": "albatross",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "scripts": {
    "dev": "pnpm db:up && pnpm generate:client && next dev",
    "start": "next start",
    "build": "pnpm generate:client && next build",
    "lint": "biome check --write . && knip",
    "lint:ci": "biome check . && knip",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset -f",
    "db:rebuild": "pnpm db:reset && pnpm db:migrate && pnpm db:seed",
    "db:studio": "prisma studio",
    "db:migrate:preview": "dotenv -e .env.preview -- prisma migrate deploy",
    "db:migrate:production": "dotenv -e .env.production -- prisma migrate deploy",
    "generate:client": "prisma generate",
    "generate:next-type": "next typegen"
  },
  "dependencies": {
    "@formkit/tempo": "1.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-select": "2.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.40.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "postcss": "8.5.28",
    "prisma": "7.10.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "code-inspector-plugin": "2.0.8",
    "dotenv": "17.4.2",
    "dotenv-cli": "11.0.0",
    "jsdom": "30.0.1",
    "knip": "6.34.0",
    "prisma-markdown": "4.0.0",
    "tsx": "4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
