{
  "name": "albatross",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a",
  "scripts": {
    "dev": "pnpm db:up && pnpm generate:client && next dev",
    "start": "next start",
    "build": "pnpm generate:client && next build",
    "lint": "biome check --write . && knip",
    "lint:ci": "biome check . && knip",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset -f",
    "db:rebuild": "pnpm db:reset && pnpm db:migrate && pnpm db:seed",
    "db:studio": "prisma studio",
    "db:migrate:preview": "dotenv -e .env.preview -- prisma migrate deploy",
    "db:migrate:production": "dotenv -e .env.production -- prisma migrate deploy",
    "generate:client": "prisma generate",
    "generate:next-type": "next typegen"
  },
  "dependencies": {
    "@formkit/tempo": "1.1.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@radix-ui/react-select": "2.3.1",
    "@tailwindcss/postcss": "4.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.21.0",
    "next": "16.2.9",
    "pg": "8.22.0",
    "postcss": "8.5.15",
    "prisma": "7.8.0",
    "radix-ui": "1.6.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.1",
    "vaul": "1.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/engines"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.0.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "dotenv": "17.4.2",
    "dotenv-cli": "11.0.0",
    "jsdom": "29.1.1",
    "knip": "6.21.0",
    "prisma-markdown": "4.0.0",
    "tsx": "4.22.4",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
