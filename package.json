{
  "name": "albatross",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "scripts": {
    "dev": "pnpm db:up && pnpm generate:client && next dev",
    "start": "next start",
    "build": "pnpm generate:client && prisma migrate deploy && next build",
    "lint": "biome check --write . && knip",
    "lint:ci": "biome check . && knip",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset -f",
    "db:rebuild": "pnpm db:reset && pnpm db:migrate && pnpm db:seed",
    "db:studio": "prisma studio",
    "db:migrate:production": "dotenv -e .env.production -- prisma migrate deploy",
    "db:seed:production": "SEED_ENV=production dotenv -e .env.production -- prisma db seed",
    "db:dump:production": "./scripts/dump-production.sh",
    "generate:client": "prisma generate",
    "generate:next-type": "next typegen"
  },
  "dependencies": {
    "@formkit/tempo": "1.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-select": "2.3.8",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "postcss": "8.5.29",
    "prisma": "7.10.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "vaul": "1.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "code-inspector-plugin": "2.0.9",
    "dotenv": "18.0.7",
    "dotenv-cli": "11.0.0",
    "jsdom": "30.1.2",
    "knip": "6.41.0",
    "prisma-markdown": "4.0.0",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
